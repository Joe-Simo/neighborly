# Free OpenRouter key (https://openrouter.ai). Without it, samples show recorded examples.
OPENROUTER_API_KEY=
# Optional: comma-separated free model ids to try in order.
NEIGHBORLY_LLM_MODELS=
# Optional: max AI calls per server per day (default 36).
NEIGHBORLY_LLM_CALLS_PER_DAY=
# Optional: read api.census.gov directly instead of Census Reporter.
CENSUS_API_KEY=
