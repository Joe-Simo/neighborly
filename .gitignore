# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling and leftovers
.playwright*/
.review-shots/
New Folder/
*.icloud-preserved.*

# source art stays on disk; only the small manifests the code imports are tracked
/art/**
!/art/*.json

# heavy assets the site does not load (same list as .vercelignore)
public/assets/monumental-*
public/assets/painted-world/*.glb
public/assets/painted-world/rooms/

# keys and notes dropped into the folder by mistake
*.rtf
*.key
